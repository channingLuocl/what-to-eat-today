[
  {"id": "A001", "query": "怎么做清蒸鲈鱼？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/aquatic/清蒸鲈鱼/清蒸鲈鱼.md"], "reference_answer": "清蒸鲈鱼：鱼洗净腌制10分钟，鱼腹塞姜葱，水开大火蒸10分钟，淋蒸鱼豉油和热油即可。", "should_answer": true, "tags": ["aquatic", "entity"]},
  {"id": "A002", "query": "蒜蓉虾的做法是什么？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/aquatic/蒜蓉虾/蒜蓉虾.md"], "reference_answer": "蒜蓉虾：处理虾后开背，铺蒜蓉、粉丝，蒸熟后浇热油酱汁。", "should_answer": true, "tags": ["aquatic", "entity"]},
  {"id": "A003", "query": "葱烧海参怎么做才好吃？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/aquatic/葱烧海参/葱烧海参.md"], "reference_answer": "葱烧海参：海参泡发处理，葱白炸至金黄，调酱汁烧入味。", "should_answer": true, "tags": ["aquatic", "entity"]},
  {"id": "A004", "query": "请告诉我糖醋鲤鱼的烹饪步骤", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/aquatic/糖醋鲤鱼/糖醋鲤鱼.md"], "reference_answer": "糖醋鲤鱼：鱼改花刀腌制，裹粉炸至金黄，调糖醋汁浇上即可。", "should_answer": true, "tags": ["aquatic", "entity"]},
  {"id": "A005", "query": "太阳蛋怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/breakfast/太阳蛋.md"], "reference_answer": "太阳蛋：平底锅小火，鸡蛋打入锅中保持蛋黄完整，盖盖煎至蛋白凝固。", "should_answer": true, "tags": ["breakfast", "entity"]},
  {"id": "A006", "query": "完美水煮蛋怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/breakfast/完美水煮蛋.md"], "reference_answer": "水煮蛋：冷水下锅，水开后定时（溏心6分钟、全熟9分钟）。", "should_answer": true, "tags": ["breakfast", "entity"]},
  {"id": "A007", "query": "燕麦鸡蛋饼的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/breakfast/燕麦鸡蛋饼.md"], "reference_answer": "燕麦鸡蛋饼：燕麦泡软，加鸡蛋调成糊，平底锅煎成饼。", "should_answer": true, "tags": ["breakfast", "entity"]},
  {"id": "A008", "query": "蒸花卷需要哪些食材？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/breakfast/蒸花卷.md"], "reference_answer": "蒸花卷：面粉、酵母、温水、油、葱花、盐。", "should_answer": true, "tags": ["breakfast", "entity"]},
  {"id": "A009", "query": "草莓酱怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/condiment/草莓酱/草莓酱.md"], "reference_answer": "草莓酱：草莓洗净切块，加糖腌出汁，小火熬煮至浓稠。", "should_answer": true, "tags": ["condiment", "entity"]},
  {"id": "A010", "query": "葱油的做法是什么？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/condiment/葱油.md"], "reference_answer": "葱油：葱段冷油下锅小火炸至焦黄，过滤即得葱油。", "should_answer": true, "tags": ["condiment", "entity"]},
  {"id": "A011", "query": "提拉米苏的具体做法", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/dessert/提拉米苏/提拉米苏.md"], "reference_answer": "提拉米苏：手指饼干蘸咖啡酒液，铺入容器；马斯卡彭奶酪+蛋黄+糖打发，分层铺好冷藏。", "should_answer": true, "tags": ["dessert", "entity"]},
  {"id": "A012", "query": "戚风蛋糕怎么做不容易塌？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/dessert/戚风蛋糕/戚风蛋糕.md"], "reference_answer": "戚风蛋糕不塌秘诀：蛋白打发到硬性发泡、烤完倒扣冷却、避免开炉门。", "should_answer": true, "tags": ["dessert", "entity"]},
  {"id": "A013", "query": "烤蛋挞需要哪些食材？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/dessert/烤蛋挞/烤蛋挞.md"], "reference_answer": "烤蛋挞：蛋挞皮、蛋黄、淡奶油、牛奶、糖。", "should_answer": true, "tags": ["dessert", "entity"]},
  {"id": "A014", "query": "杨枝甘露怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/drink/杨枝甘露.md"], "reference_answer": "杨枝甘露：芒果打成泥，加椰汁、淡奶油、西柚粒和西米。", "should_answer": true, "tags": ["drink", "entity"]},
  {"id": "A015", "query": "Mojito莫吉托怎么调？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/drink/Mojito莫吉托.md"], "reference_answer": "Mojito：薄荷叶+青柠+糖捣碎，加朗姆酒，倒入苏打水，加冰块。", "should_answer": true, "tags": ["drink", "entity"]},
  {"id": "A016", "query": "酸梅汤的做法", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/drink/酸梅汤/酸梅汤.md"], "reference_answer": "酸梅汤：乌梅、山楂、甘草等熬煮，加冰糖调味。", "should_answer": true, "tags": ["drink", "entity"]},
  {"id": "A017", "query": "怎么做红烧肉？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/红烧肉/南派红烧肉.md", "data/dishes/meat_dish/红烧肉/简易红烧肉.md"], "reference_answer": "红烧肉：五花肉切块焯水，煸炒上色，加酱油糖料酒炖至软烂。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A018", "query": "宫保鸡丁的做法是什么？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/宫保鸡丁/宫保鸡丁.md"], "reference_answer": "宫保鸡丁：鸡腿肉切丁腌制，干辣椒花椒爆香，调宫保汁炒制，最后撒花生米。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A019", "query": "可乐鸡翅怎么做才好吃？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/meat_dish/可乐鸡翅.md"], "reference_answer": "可乐鸡翅：鸡翅划口焯水，煎至两面金黄，加可乐和酱油烧至收汁。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A020", "query": "请告诉我糖醋排骨的烹饪步骤", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/糖醋排骨/糖醋排骨.md"], "reference_answer": "糖醋排骨：排骨焯水，炸至金黄，调糖醋汁翻炒收汁。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A021", "query": "麻婆豆腐需要哪些食材？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/麻婆豆腐/麻婆豆腐.md"], "reference_answer": "麻婆豆腐：豆腐、肉末、豆瓣酱、花椒、辣椒粉、葱姜蒜。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A022", "query": "回锅肉怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/回锅肉/回锅肉.md"], "reference_answer": "回锅肉：五花肉煮熟切片，加豆瓣酱蒜苗炒制。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A023", "query": "空气炸锅鸡翅中的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/semi-finished/空气炸锅鸡翅中/空气炸锅鸡翅中.md"], "reference_answer": "空气炸锅鸡翅：腌制后200度炸15分钟，中途翻面。", "should_answer": true, "tags": ["semi-finished", "entity"]},
  {"id": "A024", "query": "紫菜蛋花汤怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/soup/紫菜蛋花汤.md"], "reference_answer": "紫菜蛋花汤：水开下紫菜，鸡蛋打散淋入，调味即可。", "should_answer": true, "tags": ["soup", "entity"]},
  {"id": "A025", "query": "罗宋汤怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/soup/罗宋汤.md"], "reference_answer": "罗宋汤：番茄炒酱，加牛肉、土豆、卷心菜炖煮。", "should_answer": true, "tags": ["soup", "entity"]},
  {"id": "A026", "query": "皮蛋瘦肉粥怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/soup/皮蛋瘦肉粥.md"], "reference_answer": "皮蛋瘦肉粥：大米煮粥，加入皮蛋丁和腌好的瘦肉煮熟。", "should_answer": true, "tags": ["soup", "entity"]},
  {"id": "A027", "query": "蛋炒饭怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/staple/蛋炒饭.md"], "reference_answer": "蛋炒饭：隔夜饭+鸡蛋+葱花，热油爆炒至粒粒分明。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A028", "query": "扬州炒饭的做法", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/扬州炒饭/扬州炒饭.md"], "reference_answer": "扬州炒饭：米饭、鸡蛋、虾仁、火腿丁、青豆等炒制。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A029", "query": "炸酱面怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/炸酱面.md"], "reference_answer": "炸酱面：肉末炒酱，配菜码（黄瓜、豆芽等），煮面浇酱拌匀。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A030", "query": "西红柿鸡蛋挂面的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/staple/西红柿鸡蛋挂面/西红柿鸡蛋挂面.md"], "reference_answer": "西红柿鸡蛋挂面：番茄炒鸡蛋出汁，加水煮开下挂面。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A031", "query": "西红柿炒鸡蛋怎么做才好吃？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/西红柿炒鸡蛋.md"], "reference_answer": "西红柿炒鸡蛋：鸡蛋加少许盐打散先炒出，番茄炒出汁加糖，倒回鸡蛋翻匀。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A032", "query": "酸辣土豆丝的做法是什么？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/酸辣土豆丝.md"], "reference_answer": "酸辣土豆丝：土豆切丝过水去淀粉，热油爆香干辣椒花椒，下土豆丝快炒加醋调味。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A033", "query": "凉拌黄瓜怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/凉拌黄瓜.md"], "reference_answer": "凉拌黄瓜：黄瓜拍碎，加蒜蓉、生抽、醋、香油、辣椒油拌匀。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A034", "query": "蒜蓉西兰花的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/蒜蓉西兰花.md"], "reference_answer": "蒜蓉西兰花：西兰花焯水，蒜末爆香，下西兰花翻炒调味。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A035", "query": "鸡蛋羹怎么做才嫩？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/鸡蛋羹/鸡蛋羹.md", "data/dishes/breakfast/蒸水蛋.md"], "reference_answer": "鸡蛋羹：蛋液加1.5倍温水，过筛去泡，盖盘小火蒸8分钟。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},

