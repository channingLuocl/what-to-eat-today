  {"id": "A075", "query": "番茄炒蛋的做法", "category": "robustness_case", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/西红柿炒鸡蛋.md"], "reference_answer": "番茄炒蛋（西红柿炒鸡蛋）：鸡蛋打散先炒出，番茄出汁回锅翻炒。", "should_answer": true, "tags": ["paraphrase", "robustness"]},
  {"id": "A076", "query": "如何做糖醋排骨", "category": "robustness_case", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/糖醋排骨/糖醋排骨.md"], "reference_answer": "糖醋排骨：排骨焯水炸金黄，调糖醋汁翻炒收汁。", "should_answer": true, "tags": ["paraphrase", "robustness"]},
