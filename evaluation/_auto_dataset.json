  {"id": "A097", "query": "猪蹄能做什么菜？", "category": "ingredient_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/红烧猪蹄/红烧猪蹄.md", "data/dishes/meat_dish/老妈蹄花/老妈蹄花.md", "data/dishes/meat_dish/猪皮冻/猪皮冻.md"], "reference_answer": "猪蹄菜：红烧猪蹄、老妈蹄花、猪皮冻等。", "should_answer": true, "tags": ["ingredient", "猪蹄"]},
  {"id": "A098", "query": "鸡翅有什么做法？", "category": "ingredient_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/meat_dish/可乐鸡翅.md", "data/dishes/meat_dish/烤鸡翅.md", "data/dishes/meat_dish/甜辣烤全翅.md", "data/dishes/semi-finished/空气炸锅鸡翅中/空气炸锅鸡翅中.md"], "reference_answer": "鸡翅做法：可乐鸡翅、烤鸡翅、甜辣烤全翅、空气炸锅鸡翅。", "should_answer": true, "tags": ["ingredient", "鸡翅"]},
  {"id": "A099", "query": "用五花肉可以做什么？", "category": "ingredient_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/红烧肉/南派红烧肉.md", "data/dishes/meat_dish/回锅肉/回锅肉.md", "data/dishes/meat_dish/梅菜扣肉/梅菜扣肉.md", "data/dishes/meat_dish/粉蒸肉.md", "data/dishes/meat_dish/香煎五花肉/香煎五花肉.md"], "reference_answer": "五花肉做法：红烧肉、回锅肉、梅菜扣肉、粉蒸肉、香煎五花肉。", "should_answer": true, "tags": ["ingredient", "五花肉"]},

  {"id": "A100", "query": "韩式拌饭的做法", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/韩式拌饭/韩式拌饭.md"], "reference_answer": "韩式拌饭：石锅放米饭，铺各种炒制的菜码（豆芽、菠菜、肉、蛋等），加韩式辣酱拌匀。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A101", "query": "日式咖喱饭怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/日式咖喱饭/日式咖喱饭.md"], "reference_answer": "日式咖喱饭：洋葱胡萝卜土豆肉块炒制，加水煮，加咖喱块煮稠浇饭上。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A102", "query": "日式肥牛丼饭的做法", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/日式肥牛丼饭/日式肥牛丼饭.md"], "reference_answer": "肥牛丼饭：洋葱炒软，加酱汁煮开下肥牛，浇饭上撒葱花。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A103", "query": "意式肉酱面怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/意式肉酱面/意式肉酱面.md"], "reference_answer": "肉酱面：肉末炒香，加番茄酱、洋葱胡萝卜熬煮，配煮好的意面。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A104", "query": "意式烤鸡怎么做？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/meat_dish/意式烤鸡.md"], "reference_answer": "意式烤鸡：整鸡腌制（迷迭香、橄榄油、盐胡椒），烤箱烤制。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A105", "query": "烤鱼怎么做？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/aquatic/混合烤鱼/烤鱼.md"], "reference_answer": "烤鱼：鱼腌制烤至焦香，配菜炒香铺底，浇上辣酱。", "should_answer": true, "tags": ["aquatic", "entity"]},

  {"id": "A106", "query": "烧饼怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/烧饼/芝麻烧饼.md"], "reference_answer": "烧饼：发面，加馅料卷起，烙制后烤制。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A107", "query": "烙饼的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/staple/烙饼/烙饼.md"], "reference_answer": "烙饼：和面，擀薄抹油卷起，平底锅烙至两面金黄。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A108", "query": "韭菜盒子怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/韭菜盒子.md"], "reference_answer": "韭菜盒子：韭菜鸡蛋虾皮拌馅，面皮包成饺子状，平底锅烙熟。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A109", "query": "拌面有哪些种类？", "category": "ingredient_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/staple/葱油拌面.md", "data/dishes/staple/老干妈拌面.md", "data/dishes/staple/麻油拌面.md", "data/dishes/staple/酱拌荞麦面/酱拌荞麦面.md"], "reference_answer": "拌面：葱油拌面、老干妈拌面、麻油拌面、酱拌荞麦面。", "should_answer": true, "tags": ["ingredient", "拌面"]},
  {"id": "A110", "query": "披萨饼皮怎么做？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/staple/披萨饼皮/披萨饼皮.md"], "reference_answer": "披萨饼皮：高筋面粉+酵母+水+油揉面发酵，擀成圆饼。", "should_answer": true, "tags": ["staple", "entity"]},

