  {"id": "A082", "query": "苏格兰蛋的做法", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/breakfast/苏格兰蛋/苏格兰蛋.md"], "reference_answer": "苏格兰蛋：水煮蛋外裹肉馅，再裹面包糠炸至金黄。", "should_answer": true, "tags": ["breakfast", "entity"]},
  {"id": "A083", "query": "手工水饺需要哪些食材？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/手工水饺.md"], "reference_answer": "水饺：面粉、温水做皮；猪肉、葱姜、蔬菜做馅。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A084", "query": "鱼香肉丝怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/鱼香肉丝.md"], "reference_answer": "鱼香肉丝：肉丝腌制，木耳笋丝配菜，调鱼香汁炒制。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A085", "query": "鱼香茄子的做法是什么？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/鱼香茄子/鱼香茄子.md"], "reference_answer": "鱼香茄子：茄子炸软，调鱼香汁炒入味。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A086", "query": "新疆大盘鸡怎么做？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/meat_dish/新疆大盘鸡/新疆大盘鸡.md"], "reference_answer": "大盘鸡：鸡块炒至上色，加土豆、青椒、啤酒炖煮，可配皮带面。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A087", "query": "白灼虾怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/aquatic/白灼虾/白灼虾.md"], "reference_answer": "白灼虾：水加葱姜料酒煮开下虾，变红即捞出，蘸料食用。", "should_answer": true, "tags": ["aquatic", "entity"]},
  {"id": "A088", "query": "排骨苦瓜汤怎么做？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/soup/排骨苦瓜汤/排骨苦瓜汤.md"], "reference_answer": "排骨苦瓜汤：排骨焯水后炖煮，加入苦瓜片煮至软烂。", "should_answer": true, "tags": ["soup", "entity"]},
  {"id": "A089", "query": "番茄牛肉蛋花汤的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/soup/番茄牛肉蛋花汤.md"], "reference_answer": "番茄牛肉蛋花汤：番茄炒酱，加水加牛肉煮熟，淋蛋液出锅。", "should_answer": true, "tags": ["soup", "entity"]},
  {"id": "A090", "query": "炒青菜怎么做才好吃？", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/炒青菜.md"], "reference_answer": "炒青菜：热油大火快炒，加蒜末调味盐少许糖提鲜。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A091", "query": "蒜蓉空心菜的做法", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/蒜蓉空心菜/蒜蓉空心菜.md"], "reference_answer": "蒜蓉空心菜：热油爆蒜末，下空心菜大火翻炒，加少许盐。", "should_answer": true, "tags": ["vegetable_dish", "entity"]},
  {"id": "A092", "query": "酱牛肉怎么做？", "category": "entity_query", "difficulty": "hard", "expected_doc_paths": ["data/dishes/meat_dish/酱牛肉/酱牛肉.md"], "reference_answer": "酱牛肉：牛腱焯水，加酱料和香料炖煮，浸泡入味，切片食用。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A093", "query": "口水鸡怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/meat_dish/口水鸡/口水鸡.md"], "reference_answer": "口水鸡：鸡煮熟切块，调辣椒油+花椒+生抽汁淋上。", "should_answer": true, "tags": ["meat_dish", "entity"]},
  {"id": "A094", "query": "螺蛳粉怎么做？", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/螺蛳粉.md"], "reference_answer": "螺蛳粉：米粉煮软，加汤底、酸笋、腐竹、花生、青菜。", "should_answer": true, "tags": ["staple", "entity"]},
  {"id": "A095", "query": "热干面的做法", "category": "entity_query", "difficulty": "medium", "expected_doc_paths": ["data/dishes/staple/热干面.md"], "reference_answer": "热干面：碱面煮熟过油，调芝麻酱、生抽、醋、辣椒油拌匀。", "should_answer": true, "tags": ["staple", "entity"]},

