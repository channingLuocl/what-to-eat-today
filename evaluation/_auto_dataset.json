  {"id": "A078", "query": "酸辣土豆丝怎么炒", "category": "robustness_case", "difficulty": "easy", "expected_doc_paths": ["data/dishes/vegetable_dish/酸辣土豆丝.md"], "reference_answer": "土豆丝过水，热油爆干辣椒花椒，下锅快炒加醋。", "should_answer": true, "tags": ["paraphrase", "robustness"]},
  {"id": "A079", "query": "蛋炒饭做法", "category": "robustness_case", "difficulty": "easy", "expected_doc_paths": ["data/dishes/staple/蛋炒饭.md"], "reference_answer": "蛋炒饭：隔夜饭+鸡蛋热油爆炒至粒粒分明。", "should_answer": true, "tags": ["paraphrase", "robustness"]},

  {"id": "A080", "query": "请告诉我手抓饼的烹饪步骤", "category": "entity_query", "difficulty": "easy", "expected_doc_paths": ["data/dishes/breakfast/手抓饼.md"], "reference_answer": "手抓饼：平底锅小火，饼放入煎至两面金黄起酥层即可。", "should_answer": true, "tags": ["breakfast", "entity"]},
